---
import { contact, site, common } from "../content/site";
import Icon from "./Icon.astro";
import Square from "./Square.astro";

const tel = site.phone.replace(/[^+\d]/g, "");
---

<section class="section contact" id={contact.id} aria-labelledby="contact-title">
  <svg
    class="bg"
    width="1140"
    height="755"
    viewBox="0 0 1140 755"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      d="M1139.95 362.929C1139.95 562.856 787.951 962.932 575.95 620.932C363.95 278.932 231.951 756.931 46.2626 432.929C-139.425 108.928 273.95 -129.07 575.95 76.9307C877.95 282.931 1139.95 163.002 1139.95 362.929Z"
      fill="currentColor"
    ></path>
  </svg>

  <div class="container inner">
    <div class="details">
      <h2 id="contact-title">{contact.title}</h2>
      <ul class="items">
        <li>
          <Icon name="mail" size={24} />
          <a href={`mailto:${site.email}`}>
            <span class="visually-hidden">{contact.emailLabel}: </span>
            {site.email}
          </a>
        </li>
        <li>
          <Icon name="phone" size={24} />
          <a href={`tel:${tel}`}>
            <span class="visually-hidden">{contact.phoneLabel}: </span>
            {site.phone}
          </a>
        </li>
        <li>
          <Icon name="building" size={24} />
          <span>{site.legalName}</span>
        </li>
        <li>
          <Icon name="id" size={24} />
          <span>
            {contact.businessIdLabel} {site.businessId}
          </span>
        </li>
      </ul>
      <a class="social" href={site.linkedinCompany} target="_blank" rel="noopener">
        <Icon name="linkedin" size={48} />
        <span class="visually-hidden">{contact.linkedinLabel} {common.newTab}</span>
      </a>
    </div>

    <div class="card-wrap">
      <Square color="accent" size={62} left={-52} top={-30} class="hide-md" />
      <Square color="secondary" size={99} right={-60} top={-50} class="hide-md" />
      <Square color="secondary" size={130} left={-90} bottom={-40} blur class="hide-md" />
      <div class="card">
        <h3>{contact.card.title}</h3>
        <p>{contact.card.text}</p>
        <a class="btn btn--secondary" href={`mailto:${site.email}`}>
          {contact.card.button}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-bottom: 56px;
    overflow-x: clip;
  }
  @media (min-width: 768px) {
    .contact {
      padding-bottom: 64px;
    }
  }
  @media (min-width: 1170px) {
    .contact {
      padding-bottom: 120px;
    }
  }
  .bg {
    position: absolute;
    top: 0;
    left: calc(50% - 80px);
    z-index: -1;
    color: var(--bg-soft);
  }
  @media (max-width: 1169px) {
    .bg {
      display: none;
    }
  }
  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
  }
  @media (min-width: 1170px) {
    .inner {
      flex-direction: row;
      align-items: flex-start;
    }
  }
  .details {
    margin-bottom: 32px;
    text-align: center;
  }
  @media (min-width: 768px) {
    .details {
      margin-bottom: 48px;
    }
  }
  @media (min-width: 1170px) {
    .details {
      margin: 48px 0 0;
      text-align: left;
    }
  }
  h2 {
    margin-bottom: 24px;
  }
  @media (min-width: 1170px) {
    h2 {
      margin-bottom: 32px;
    }
  }
  .items li {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 44px;
    color: var(--muted);
  }
  @media (min-width: 1170px) {
    .items li {
      justify-content: flex-start;
    }
  }
  .items :global(svg) {
    flex: none;
    color: var(--brand-text);
  }
  .items li:nth-child(2) :global(svg) {
    color: var(--tone-accent);
  }
  .items li:nth-child(1) :global(svg) {
    color: var(--tone-secondary);
  }
  .items a {
    padding-block: 8px;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-underline-offset: 4px;
  }
  .items a:hover {
    color: var(--brand-text);
    text-decoration-color: currentColor;
  }
  .social {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-top: 16px;
    color: var(--brand-text); /* 9.7:1 (was #8a8f92, 3.3:1) */
    border-radius: 50%;
    transition: background-color var(--ease);
  }
  .social:hover {
    background: color-mix(in srgb, var(--brand-text) 12%, transparent);
  }
  .card-wrap {
    position: relative;
    width: 100%;
    max-width: 544px;
  }
  .card {
    position: relative;
    padding: 24px;
    color: var(--white);
    background: var(--primary);
    border-radius: 24px;
    box-shadow: 0 24px 32px rgba(12, 75, 91, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .card :global(:focus-visible) {
    outline-color: var(--on-dark-focus);
  }
  @media (min-width: 768px) {
    .card {
      padding: 48px;
      border-radius: 64px;
    }
  }
  .card h3 {
    margin-bottom: 16px;
    font-size: 1.75rem;
    line-height: 1.25;
    color: var(--white);
  }
  .card p {
    margin-bottom: 32px;
    color: rgba(255, 255, 255, 0.9); /* 7.9:1 on #0c4b5b */
  }
  @media (max-width: 1169px) {
    .contact :global(.hide-md) {
      display: none;
    }
  }
</style>
