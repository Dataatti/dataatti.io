---
import { Image } from "astro:assets";
import photo from "../assets/petro.jpg";
import { about, site } from "../content/site";
import Icon from "./Icon.astro";
import Square from "./Square.astro";

// Split paragraphs around the {hackathon} placeholder so the link can be rendered as an element.
const parts = about.paragraphs.map((p) => p.split("{hackathon}"));
---

<section class="section about" id={about.id} aria-labelledby="about-title">
  <svg
    class="bg"
    viewBox="0 0 1600 935"
    preserveAspectRatio="none"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      d="M0 0C183.421 448.627 632.222 530.859 900 403.893C1167.78 276.927 1344.44 227.94 1600 295.922V807.786C1237.78 1138.7 655.556 710.812 0 784.792V0Z"
      fill="currentColor"
    ></path>
  </svg>

  <div class="container inner">
    <div class="profile-wrap">
      <Square color="accent" size={71} right={-48} top={42} blur />
      <Square color="accent" size={45} left={-87} bottom={54} blur class="hide-sm" />
      <Square color="secondary" size={130} left={182} bottom={-94} blur />
      <Square color="accent" size={42} left={20} top={-40} />
      <Square color="accent" size={65} left={-25} bottom={-29} />
      <Square color="accent" size={80} right={-40} bottom={36} />
      <Square color="secondary" size={33} right={-30} top={160} />
      <Square color="secondary" size={89} left={-50} top={33} />

      <figure class="profile">
        <Image
          class="avatar"
          src={photo}
          alt={about.photoAlt}
          width={152}
          height={152}
          densities={[1, 2]}
          quality={80}
        />
        <figcaption>
          <strong class="name">{about.name}</strong>
          <span class="role">{about.role}</span>
        </figcaption>
        <a class="in" href={site.linkedinPerson} target="_blank" rel="noopener">
          <Icon name="linkedin" size={28} />
          <span class="visually-hidden">{about.linkedinLabel}</span>
        </a>
      </figure>
    </div>

    <div class="caption">
      <h2 id="about-title">{about.title}</h2>
      {parts.map(([before, after]) => (
        <p class="para">
          {before}
          {after !== undefined && (
            <>
              <a class="text-link" href={about.hackathon.href} target="_blank" rel="noopener">
                {about.hackathon.label}
              </a>
              {after}
            </>
          )}
        </p>
      ))}
    </div>
  </div>
</section>

<style>
  .about {
    overflow-x: clip;
  }
  .bg {
    position: absolute;
    top: -150px;
    left: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    color: var(--bg-soft);
  }
  @media (max-width: 767px) {
    .bg {
      top: 200px;
      height: 50%;
    }
  }
  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
  }
  @media (min-width: 1170px) {
    .inner {
      flex-direction: row;
    }
  }
  .profile-wrap {
    position: relative;
    width: 100%;
    max-width: 400px;
    margin: 30px 0 60px;
  }
  @media (min-width: 1170px) {
    .profile-wrap {
      margin: 0 40px 0 0;
    }
  }
  .profile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    padding: 48px 32px 40px;
    text-align: center;
    background: var(--white);
    border-radius: 128px 0;
    box-shadow: var(--shadow-card);
  }
  .profile :global(.avatar) {
    width: 152px;
    height: 152px;
    margin-bottom: 16px;
    object-fit: cover;
    border-radius: 50%;
  }
  .name {
    display: block;
    font-size: 20px;
    line-height: 1.6;
    color: var(--black);
  }
  .role {
    display: block;
    color: var(--muted);
  }
  .in {
    display: inline-flex;
    margin-top: 12px;
    color: var(--primary);
    transition: color var(--ease);
  }
  .in:hover {
    color: var(--primary-1);
  }
  .caption {
    max-width: 544px;
    text-align: center;
  }
  @media (min-width: 1170px) {
    .caption {
      text-align: left;
    }
  }
  h2 {
    margin-bottom: 24px;
  }
  .para + .para {
    margin-top: 16px;
  }
  .para {
    color: var(--text);
  }
  @media (max-width: 449px) {
    .about :global(.hide-sm) {
      display: none;
    }
  }
</style>
