---
import { howItWorks } from "../content/site";
import Icon from "./Icon.astro";

// Each step grows and warms up towards the session itself.
const tones = ["secondary", "primary-1", "primary", "accent"];
const sizes = [64, 76, 88, 104];
---

<section class="section how" id={howItWorks.id} aria-labelledby="how-title">
  <div class="container">
    <div class="head">
      <h2 class="section-title" id="how-title">
        {howItWorks.title}
      </h2>
      <p class="section-text">{howItWorks.text}</p>
    </div>
    <div class="track">
      <svg class="path" viewBox="0 0 100 220" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="how-grad" x1="0" x2="1" y1="0" y2="0">
            <stop offset="0" stop-color="#51b3a7" />
            <stop offset="0.6" stop-color="#0c4b5b" />
            <stop offset="1" stop-color="#d06f3f" />
          </linearGradient>
        </defs>
        <path
          d="M12.5 208 C 25 208, 25 156, 37.5 156 S 50 104, 62.5 104 S 75 52, 87.5 52"
        />
      </svg>
      <ol class="grid">
        {howItWorks.steps.map((step, i) => (
          <li class="step" style={`--i:${i};--s:${sizes[i]}px`}>
            <span class={`icon icon--${tones[i]}`}>
              <Icon name={step.icon} size={Math.round(sizes[i] * 0.42)} />
            </span>
            <div class="body">
              <h3>{step.title}</h3>
              <p class="text">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  const track = document.querySelector(".how .track");
  if (track) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          track.classList.add("is-in");
          io.disconnect();
        }
      },
      { threshold: 0.35 },
    );
    track.classList.add("will-animate");
    io.observe(track);
  }
</script>

<style>
  .head {
    margin-bottom: 48px;
  }
  .track {
    position: relative;
    max-width: 1088px;
    margin: 0 auto;
  }

  /* Mobile & tablet: vertical timeline, icons grow along a rising line. */
  .grid {
    position: relative;
    display: grid;
    gap: 32px;
    max-width: 620px;
    margin: 0 auto;
  }
  .grid::before {
    position: absolute;
    top: 32px;
    bottom: 52px;
    left: 51px;
    width: 3px;
    content: "";
    border-radius: 3px;
    background: linear-gradient(var(--secondary), var(--primary) 60%, var(--accent));
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 104px 1fr;
    align-items: center;
    gap: 20px;
  }
  .step:nth-child(even) .body {
    padding-left: 24px;
  }
  .icon {
    display: grid;
    place-items: center;
    justify-self: center;
    width: var(--s);
    height: var(--s);
    color: var(--white);
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 20px 28px color-mix(in srgb, var(--c) 22%, transparent);
  }
  .icon--secondary {
    --c: #257a6f; /* white icon 5.1:1 */
  }
  .icon--primary-1 {
    --c: var(--primary-1);
  }
  .icon--primary {
    --c: var(--primary);
  }
  .icon--accent {
    --c: #b05827; /* white icon 4.9:1 */
    box-shadow:
      0 0 0 10px color-mix(in srgb, var(--accent) 16%, transparent),
      0 24px 32px color-mix(in srgb, var(--accent) 28%, transparent);
  }
  h3 {
    margin-bottom: 6px;
    font-size: 1.25rem;
  }
  .step:last-child h3 {
    color: var(--tone-accent);
  }
  .text {
    max-width: 34ch;
    color: var(--muted);
  }
  .path {
    display: none;
  }

  /* Desktop: a rising staircase joined by a curve. */
  @media (min-width: 1170px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 40px;
      max-width: none;
    }
    .grid::before {
      display: none;
    }
    .step {
      grid-template-columns: 1fr;
      align-items: start;
      align-content: start;
      gap: 0;
      text-align: center;
      /* Icon centre sits on the curve: 208 → 52px, 52px rise per step. */
      padding-top: calc(208px - var(--i) * 52px - var(--s) / 2);
    }
    .step:nth-child(even) .body {
      padding-left: 0;
    }
    .icon {
      margin-bottom: 20px;
    }
    .text {
      margin: 0 auto;
      max-width: 28ch;
    }
    .path {
      position: absolute;
      top: 0;
      left: 0;
      display: block;
      width: 100%;
      height: 220px;
      overflow: visible;
    }
    .path path {
      fill: none;
      stroke: url(#how-grad);
      stroke-width: 3;
      stroke-linecap: round;
      vector-effect: non-scaling-stroke;
    }
  }

  /* Reveal: the line draws in and the steps follow it. */
  @media (prefers-reduced-motion: no-preference) {
    .will-animate .step {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 0.5s ease,
        transform 0.5s cubic-bezier(0.2, 0, 0, 1);
      transition-delay: calc(var(--i) * 0.22s + 0.1s);
    }
    .will-animate.is-in .step {
      opacity: 1;
      transform: none;
    }
    .will-animate .path {
      clip-path: inset(-20px 100% -20px 0);
      transition: clip-path 1.1s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .will-animate.is-in .path {
      clip-path: inset(-20px 0 -20px 0);
    }
  }
</style>
