---
import { packages, pricing, shop } from "../content/packages";
import { packagesSection } from "../content/site";
import Icon from "./Icon.astro";
import Square from "./Square.astro";

const tones = ["primary", "secondary", "accent"];
---

<section class="section packages" id={packagesSection.id} aria-labelledby="packages-title">
  <svg
    class="bg"
    viewBox="0 0 1600 936"
    preserveAspectRatio="none"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      d="M1600 0C1416.58 448.746 967.778 531 700 404C432.222 277 255.556 228 0 296V808C362.222 1139 944.444 711 1600 785V0Z"
      fill="currentColor"
    ></path>
  </svg>

  <div class="container wrap">
    <Square color="secondary" size={99} left={272} top={-84} back class="hide-md" />
    <Square color="accent" size={72} left={674} top={-70} back class="hide-md" />
    <Square color="secondary" size={36} left={-132} top={289} back class="hide-md" />
    <Square color="accent" size={88} left={-124} bottom={234} back class="hide-md" />
    <Square color="secondary" size={99} right={-117} top={237} back class="hide-md" />
    <Square color="accent" size={72} right={-79} bottom={59} back class="hide-md" />
    <Square color="accent" size={79} left={-125} top={126} blur class="hide-md" />
    <Square color="secondary" size={90} right={-90} bottom={120} blur class="hide-md" />

    <h2 class="section-title" id="packages-title">
      {packagesSection.title}
    </h2>
    <p class="section-text intro">{packagesSection.text}</p>

    <ul class="cards">
      {packages.map((pkg, i) => (
        <li class={`card tone-${tones[i % tones.length]}`}>
          <h3>{pkg.title}</h3>
          <p class="pitch">{pkg.pitch}</p>

          <div class="price" aria-label={`${pricing.price} ${pricing.vatNote}`}>
            <span class="amount">{pricing.price}</span>
            <span class="vat">{pricing.vatNote}</span>
          </div>
          <p class="gross">{pricing.grossNote}</p>

          <p class="includes-label">{packagesSection.includesLabel}</p>
          <ul class="list">
            {pkg.includes.map((item) => (
              <li>
                <Icon name="check" size={22} />
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <a
            class={`btn btn--${tones[i % tones.length]}`}
            href={pkg.url}
            target="_blank"
            rel="noopener"
          >
            {pricing.buttonLabel}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="notes">
      {packagesSection.notes.map((note) => (
        <p>{note}</p>
      ))}
      <p>
        <a class="text-link" href={shop.url} target="_blank" rel="noopener">
          {shop.linkLabel}
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .packages {
    overflow-x: clip;
  }
  .bg {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: 100%;
    height: 80%;
    color: var(--bg-soft);
  }
  @media (max-width: 767px) {
    .bg {
      top: 400px;
      height: 50%;
    }
  }
  .wrap {
    position: relative;
  }
  .intro {
    margin-bottom: 48px;
  }
  .cards {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
    max-width: 480px;
    margin: 0 auto;
  }
  @media (min-width: 1170px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
      max-width: none;
    }
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 40px 28px;
    background: var(--white);
    border-radius: 32px;
    box-shadow: var(--shadow-card);
  }
  @media (min-width: 768px) {
    .card {
      padding: 48px 32px;
      border-radius: 64px;
    }
  }
  .tone-primary {
    --tone: var(--primary);
    --tone-soft: var(--primary-2);
  }
  .tone-secondary {
    --tone: #257a6f;
    --tone-soft: var(--secondary);
  }
  .tone-accent {
    --tone: #b05827;
    --tone-soft: var(--accent);
  }
  h3 {
    margin-bottom: 12px;
    text-align: center;
    color: var(--tone);
  }
  @media (min-width: 1170px) {
    h3 {
      min-height: 2.8em;
    }
  }
  .pitch {
    margin-bottom: 32px;
    text-align: center;
    color: var(--muted);
  }
  .price {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 8px;
    color: var(--tone);
  }
  .amount {
    font-size: 64px;
    font-weight: 700;
    line-height: 1;
  }
  .vat {
    font-size: 24px;
    font-weight: 700;
  }
  .gross {
    margin-top: 4px;
    font-size: 14px;
    text-align: center;
    color: var(--muted);
  }
  .includes-label {
    margin-top: 32px;
    font-size: 14px;
    font-weight: 700;
    color: var(--black);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .list {
    flex: 1;
    margin-bottom: 30px;
  }
  .list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .list :global(svg) {
    flex: none;
    margin-top: 4px;
    color: var(--tone-soft);
  }
  .card .btn {
    align-self: center;
  }
  .notes {
    max-width: 736px;
    margin: 56px auto 0;
    text-align: center;
    color: var(--muted);
  }
  .notes p + p {
    margin-top: 8px;
  }

  @media (max-width: 1169px) {
    .packages :global(.hide-md) {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .packages :global(.hide-sm) {
      display: none;
    }
  }
</style>
