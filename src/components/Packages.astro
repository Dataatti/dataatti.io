---
import { packages, pricing, shop } from "../content/packages";
import { packagesSection, common } from "../content/site";
import Icon from "./Icon.astro";
import Square from "./Square.astro";

const tones = ["primary", "secondary", "accent"];
---

<section class="section packages" id={packagesSection.id} aria-labelledby="packages-title">
  <svg
    class="bg"
    viewBox="0 0 1600 936"
    preserveAspectRatio="none"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      d="M1600 0C1416.58 448.746 967.778 531 700 404C432.222 277 255.556 228 0 296V808C362.222 1139 944.444 711 1600 785V0Z"
      fill="currentColor"
    ></path>
  </svg>

  <div class="container wrap">
    <Square color="secondary" size={99} left={272} top={-84} back class="hide-md" />
    <Square color="accent" size={72} left={674} top={-70} back class="hide-md" />
    <Square color="accent" size={88} left={-124} bottom={234} back class="hide-md" />
    <Square color="secondary" size={99} right={-117} top={237} back class="hide-md" />
    <Square color="secondary" size={90} right={-90} bottom={120} blur class="hide-md" />

    <h2 class="section-title" id="packages-title">
      {packagesSection.title}
    </h2>
    <p class="section-text intro">{packagesSection.text}</p>

    <ul class="cards">
      {packages.map((pkg, i) => (
        <li class={`card tone-${tones[i % tones.length]}`}>
          <span class="badge">
            <Icon name={pkg.icon} size={28} />
          </span>
          <h3>{pkg.title}</h3>
          <p class="pitch">{pkg.pitch}</p>
          <p class="meta">
            <span class="chip">{pricing.format}</span>
            {pkg.duration && (
              <span class="chip">
                {pricing.durationLabel}: {pkg.duration}
              </span>
            )}
          </p>
          <p class="fit">
            <strong>{pricing.goodFitLabel}</strong>
            {pkg.goodFit}
          </p>

          <div class="price">
            <span class="amount">{pricing.price}</span>
            <span class="vat">{pricing.vatNote}</span>
          </div>
          <p class="gross">{pricing.grossNote}</p>

          <p class="includes-label">{packagesSection.includesLabel}</p>
          <ul class="list">
            {pkg.includes.map((item) => (
              <li>
                <Icon name="check" size={22} />
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <a
            class={`btn btn--${tones[i % tones.length]}`}
            href={pkg.url}
            target="_blank"
            rel="noopener"
          >
            {pricing.buttonLabel}
            <span class="visually-hidden"> {common.newTab}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="notes">
      {packagesSection.notes.map((note) => (
        <p>{note}</p>
      ))}
      <p>
        <a class="text-link" href={shop.url} target="_blank" rel="noopener">
          {shop.linkLabel}<span class="visually-hidden"> {common.newTab}</span>
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .packages {
    overflow-x: clip;
  }
  .bg {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: 100%;
    height: 80%;
    color: var(--bg-soft);
  }
  @media (max-width: 767px) {
    .bg {
      top: 400px;
      height: 50%;
    }
  }
  .wrap {
    position: relative;
  }
  .intro {
    margin-bottom: 48px;
  }
  .cards {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
    max-width: 480px;
    margin: 0 auto;
  }
  @media (min-width: 1170px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
      max-width: none;
    }
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 40px 28px;
    background: var(--surface);
    border: 1px solid var(--card-edge);
    border-radius: 32px;
    box-shadow: var(--shadow-card);
  }
  @media (min-width: 768px) {
    .card {
      padding: 48px 32px;
      border-radius: 64px;
    }
  }
  /* --tone: text/icon/badge colour, >= 4.9:1 on the card in both schemes */
  .tone-primary {
    --tone: var(--brand-text);
    --badge: var(--primary);
  }
  .tone-secondary {
    --tone: var(--tone-secondary);
    --badge: #257a6f;
  }
  .tone-accent {
    --tone: var(--tone-accent);
    --badge: #b05827;
  }
  .badge {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin: 0 auto 20px;
    color: var(--white);
    background: var(--badge);
    border-radius: 20px;
  }
  h3 {
    margin-bottom: 12px;
    font-size: 1.375rem;
    text-align: center;
    color: var(--tone);
  }
  @media (min-width: 1170px) {
    .card {
      /* rows line up across the three cards: badge, title, pitch, ..., button */
      display: grid;
      grid-row: span 10;
      grid-template-rows: subgrid;
    }
    .cards {
      row-gap: 0;
    }
    .list {
      align-self: start;
    }
  }
  .pitch {
    text-align: center;
    color: var(--muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }
  .chip {
    padding: 2px 12px;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.6;
    color: var(--tone);
    background: color-mix(in srgb, var(--tone) 10%, transparent);
    border-radius: 999px;
  }
  .fit {
    margin: 16px 0 28px;
    padding: 12px 16px;
    font-size: 0.9375rem;
    text-align: center;
    color: var(--text);
    background: var(--bg-soft);
    border-radius: 16px;
  }
  .fit strong {
    display: block;
    font-size: 0.875rem;
    color: var(--heading);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .price {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 8px;
    color: var(--tone);
  }
  .amount {
    font-size: 4rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    font-weight: 700;
    line-height: 1;
  }
  .vat {
    font-size: 1.5rem;
    font-weight: 700;
  }
  .gross {
    margin-top: 4px;
    font-size: 0.875rem;
    text-align: center;
    color: var(--muted);
  }
  .includes-label {
    margin-top: 32px;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--heading);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .list {
    margin-bottom: 30px;
  }
  .list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .list :global(svg) {
    flex: none;
    margin-top: 4px;
    color: var(--tone);
  }
  .card .btn {
    align-self: center;
    justify-self: center;
  }
  .notes {
    max-width: 736px;
    margin: 56px auto 0;
    text-align: center;
    color: var(--muted);
  }
  .notes p + p {
    margin-top: 8px;
  }

  @media (max-width: 1169px) {
    .packages :global(.hide-md) {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .packages :global(.hide-sm) {
      display: none;
    }
  }
</style>
