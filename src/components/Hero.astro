---
import { Image } from "astro:assets";
import { common, hero, site } from "../content/site";
import photo from "../assets/petro.jpg";
import Square from "./Square.astro";
import Icon from "./Icon.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container inner">
    <div class="caption">
      <h1 id="hero-title">{hero.title}</h1>
      <p class="lead">{hero.text}</p>
      <div class="actions">
        <a class="btn" href={hero.primary.href}>
          {hero.primary.label}
        </a>
        <a class="btn btn--ghost" href={hero.secondary.href}>
          {hero.secondary.label}
        </a>
      </div>
    </div>

    <div class="visual">
      <Square color="accent" size={80} right={-40} top={-49} />
      <Square color="accent" size={62} left={-38} top={124} />
      <Square color="secondary" size={48} right={148} bottom={-24} />
      <Square color="accent" size={75} left={-105} bottom={60} blur />
      <Square color="accent" size={80} left={120} top={-57} blur />
      <Square color="secondary" size={99} right={-60} top={40} blur />

      <div class="card">
        <div class="profile">
          <Image
            class="avatar"
            src={photo}
            alt={hero.card.photoAlt}
            width={104}
            height={104}
            densities={[1, 2]}
            loading="eager"
          />
          <div class="who">
            <p class="name">{hero.card.name}</p>
            <p class="role">{hero.card.role}</p>
          </div>
          <a class="in" href={site.linkedinPerson} target="_blank" rel="noopener">
            <Icon name="linkedin" size={28} />
            <span class="visually-hidden">{hero.card.linkedinLabel} {common.newTab}</span>
          </a>
        </div>
        <p class="card-label">{hero.card.label}</p>
        <p class="card-title">{hero.card.title}</p>
        <ul class="card-list">
          {hero.card.items.map((item) => (
            <li>
              <Icon name="check" size={22} />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 32px 0 0;
    overflow-x: clip;
  }
  @media (min-width: 1170px) {
    .hero {
      padding-bottom: 60px;
    }
  }
  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
  }
  .inner::after {
    position: absolute;
    top: 0;
    left: 56%;
    z-index: -1;
    display: block;
    width: 100vw;
    height: 648px;
    content: "";
    background: var(--bg-soft);
    border-top-left-radius: 324px;
    border-bottom-left-radius: 324px;
  }
  @media (min-width: 1170px) {
    .inner {
      flex-direction: row;
    }
  }
  .caption {
    max-width: 480px;
    margin: 30px 0;
  }
  @media (min-width: 1170px) {
    .caption {
      margin: 135px 0;
    }
  }
  h1 {
    margin-bottom: 24px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-top: 32px;
  }
  .visual {
    position: relative;
    z-index: 4;
    width: 100%;
    max-width: 544px;
    margin: 90px 0;
  }
  @media (min-width: 1170px) {
    .visual {
      margin: 0;
    }
  }
  .card {
    position: relative;
    padding: 32px 24px;
    color: var(--white);
    background: var(--primary);
    border-radius: 24px;
    box-shadow: 0 24px 32px rgba(12, 75, 91, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .card :global(:focus-visible) {
    outline-color: var(--on-dark-focus);
  }
  @media (min-width: 768px) {
    .card {
      padding: 48px;
      border-radius: 64px;
    }
  }
  .profile {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 24px;
    margin-bottom: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }
  .avatar {
    flex: none;
    width: 88px;
    height: 88px;
    object-fit: cover;
    border-radius: 50%;
    box-shadow: 0 0 0 4px var(--white);
  }
  @media (min-width: 768px) {
    .avatar {
      width: 104px;
      height: 104px;
    }
  }
  .who {
    flex: 1;
    min-width: 0;
  }
  .name {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--white);
  }
  .role {
    color: rgba(255, 255, 255, 0.8);
  }
  .in {
    flex: none;
    display: inline-flex;
    padding: 8px;
    color: var(--white);
    border-radius: 12px;
    transition: color 0.2s ease;
  }
  .in:hover {
    color: var(--secondary-1);
  }
  .card-label {
    margin-bottom: 8px;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--secondary-2); /* 5.7:1 on #0c4b5b */
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .card-title {
    margin-bottom: 24px;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--white);
    text-wrap: balance;
  }
  .card-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .card-list :global(svg) {
    flex: none;
    margin-top: 5px;
    color: var(--secondary-1);
  }
</style>
