---
import { footer } from "../content/site";

const text = footer.copyright.replace("{year}", String(new Date().getFullYear()));
---

<footer class="footer">
  <div class="container">
    <p>{text}</p>
  </div>
</footer>

<style>
  .footer {
    padding: 24px 0 32px;
    font-size: 0.875rem;
    color: var(--muted);
    text-align: center;
  }
</style>
