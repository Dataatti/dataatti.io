---
import { footer } from "../content/site";

const text = footer.copyright.replace("{year}", String(new Date().getFullYear()));
---

<footer class="footer">
  <div class="container">
    <p>{text}</p>
  </div>
</footer>

<style>
  .footer {
    padding: 18px 0;
    color: var(--muted);
  }
</style>
