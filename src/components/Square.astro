---
/**
 * Decorative floating square (rounded frame). Pure CSS, no SVG filters.
 * Position it with the top/right/bottom/left props (px numbers).
 */
interface Props {
  color: "accent" | "secondary";
  size: number;
  blur?: boolean;
  /** Draw behind the content instead of in front of it. */
  back?: boolean;
  top?: number;
  right?: number;
  bottom?: number;
  left?: number;
  /** Extra classes, e.g. to hide on small screens. */
  class?: string;
}

const {
  color,
  size,
  blur = false,
  back = false,
  top,
  right,
  bottom,
  left,
  class: cls,
} = Astro.props;

const px = (n?: number) => (n === undefined ? "" : `${n}px`);
const style = [
  `--s:${size}px`,
  top !== undefined && `top:${px(top)}`,
  right !== undefined && `right:${px(right)}`,
  bottom !== undefined && `bottom:${px(bottom)}`,
  left !== undefined && `left:${px(left)}`,
]
  .filter(Boolean)
  .join(";");
---

<span
  class:list={["sq", `sq--${color}`, { "sq--blur": blur, "sq--back": back }, cls]}
  style={style}
  aria-hidden="true"
></span>

<style>
  .sq {
    position: absolute;
    z-index: 2;
    width: var(--s);
    height: var(--s);
    pointer-events: none;
    border: calc(var(--s) / 6) solid currentColor;
    border-radius: calc(var(--s) / 3);
    filter: drop-shadow(0 calc(var(--s) * 0.5) calc(var(--s) * 0.5) var(--shadow));
    --dx: 10px;
    --dy: 10px;
  }
  .sq--accent {
    color: var(--accent);
    --shadow: rgba(208, 111, 63, 0.18);
  }
  .sq--secondary {
    color: var(--secondary);
    --shadow: rgba(81, 179, 167, 0.18);
  }
  .sq--back {
    z-index: -1;
  }
  .sq--blur {
    z-index: -1;
    opacity: 0.2;
    filter: blur(calc(var(--s) * 0.1));
    --dx: -5px;
    --dy: -5px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sq {
      animation:
        sq-x 10s infinite ease-in,
        sq-y 7s infinite ease-out;
    }
  }

  @keyframes sq-x {
    50% {
      translate: var(--dx) 0;
    }
  }
  @keyframes sq-y {
    50% {
      transform: translateY(var(--dy));
    }
  }
</style>
